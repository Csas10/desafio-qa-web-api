        {
          "name": "API-PRO-03 Remover produto existente",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/products/1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Tempo menor que 2000ms', () => pm.expect(pm.response.responseTime).to.be.below(2000));",
                  "pm.test('Content-Type JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.match(/application\\/json/i));",
                  "pm.test('Schema com campos e tipos obrigatorios', () => pm.response.to.have.jsonSchema({\"type\":\"object\",\"required\":[\"id\",\"title\",\"price\",\"category\",\"isDeleted\",\"deletedOn\"],\"properties\":{\"id\":{\"type\":\"integer\",\"minimum\":1},\"title\":{\"type\":\"string\"},\"price\":{\"type\":\"number\"},\"category\":{\"type\":\"string\"},\"isDeleted\":{\"type\":\"boolean\"},\"deletedOn\":{\"type\":\"string\"}},\"additionalProperties\":true}));",
                  "pm.test('Conteudo esperado', () => { const j = pm.response.json();",
                  "pm.expect(j.id).to.eql(1);",
                  "pm.expect(j.isDeleted).to.eql(true);",
                  "pm.expect(Number.isNaN(Date.parse(j.deletedOn))).to.eql(false);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
